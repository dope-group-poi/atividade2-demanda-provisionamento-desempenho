[Unit]
Description=POI app (%i) - demanda/provisionamento/desempenho
After=network.target

[Service]
Type=simple
# %i = nome da instancia: cpu_app | memory_app | io_app
User=poi
WorkingDirectory=/opt/poi/apps/%i
EnvironmentFile=/opt/poi/deploy/%i.env
ExecStart=/opt/poi/.venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT} --workers ${WORKERS}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
